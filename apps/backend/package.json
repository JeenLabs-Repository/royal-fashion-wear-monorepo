{
  "name": "@dtc/gorgo-medusa-backend",
  "version": "1.0.0",
  "description": "Medusa backend of the Medusa DTC Starter by Gorgo.",
  "author": "Gorgo (https://gorgojs.com)",
  "license": "MIT",
  "homepage": "https://docs.gorgojs.com/tools/medusa-dtc-starter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorgojs/medusa-dtc-starter.git",
    "directory": "apps/backend"
  },
  "bugs": "https://github.com/gorgojs/medusa-dtc-starter/issues",
  "keywords": [
    "medusa",
    "medusa-starter",
    "ecommerce",
    "headless",
    "postgres",
    "typescript",
    "gorgo"
  ],
  "scripts": {
    "build": "medusa build && node scripts/copy-migration-data.js && node scripts/copy-vendor-agreements.js",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "ALLOW_DEMO_SEED=1 medusa exec ./src/migration-scripts/initial-data-seed.ts",
    "build:pincodes": "medusa exec ./scripts/build-pincode-data.ts",
    "bootstrap:production": "medusa exec ./src/scripts/bootstrap-production.ts",
    "seed:test-data": "TEST_DATA_SEED=1 medusa exec ./src/migration-scripts/test-data-seed.ts",
    "seed:staff-demo": "medusa exec ./src/scripts/seed-staff-demo.ts",
    "staff:grant-superadmin": "medusa exec ./src/scripts/grant-superadmin.ts",
    "staff:create-break-glass": "medusa exec ./src/scripts/create-break-glass.ts",
    "staff:rotate-break-glass": "medusa exec ./src/scripts/rotate-break-glass.ts",
    "staff:list": "medusa exec ./src/scripts/list-staff.ts",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:canary": "TEST_TYPE=canary NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "check:admin-routes": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --testPathPattern=admin-routes-mapped",
    "check:governance": "pnpm run check:admin-routes && pnpm run test:unit && pnpm run test:integration:modules && pnpm run test:integration:http",
    "seed:india": "medusa exec ./src/scripts/seed-india-commerce.ts"
  },
  "dependencies": {
    "@gorgo/medusa-integration": "2.0.0",
    "@jeenlabs-repository/medusa-payment-razorpay": "0.1.0",
    "@jeenlabs-repository/medusa-store-settings": "0.1.0",
    "@medusajs/admin-sdk": "2.22.7",
    "@medusajs/admin-shared": "2.22.7",
    "@medusajs/caching": "2.22.7",
    "@medusajs/cli": "2.22.7",
    "@medusajs/dashboard": "2.22.7",
    "@medusajs/draft-order": "2.22.7",
    "@medusajs/framework": "2.22.7",
    "@medusajs/js-sdk": "2.22.7",
    "@medusajs/medusa": "2.22.7",
    "@medusajs/ui": "4.2.14",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tanstack/react-query": "5.64.2",
    "csv-parse": "7.0.3",
    "intl-messageformat": "^10.7.16",
    "multer": "2.5.0",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "sharp": "0.35.5",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.7",
    "@medusajs/test-utils": "2.22.7",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/multer": "2.3.0",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.18.0"
}
