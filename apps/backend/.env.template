# Local development values. Generate real secrets with `openssl rand -hex 32`
# (64 characters; the production start-up check demands at least 32). Production
# values come from the deployment environment and never from this file. Every
# backend process must use the same INTEGRATION_ENCRYPTION_KEY.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000
REDIS_URL=redis://localhost:6379
# Development runs the cache, event bus, and workflow engine in memory.
# Uncomment to use REDIS_URL in development too. Production always uses it.
# USE_REDIS=true
JWT_SECRET=replace-me
COOKIE_SECRET=replace-me
DB_NAME=medusa_dtc_starter
DATABASE_URL=postgres://postgres:postgres@localhost:5432/$DB_NAME
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=medusa-storefront

# Medusa Integration Module (see https://gorgojs.com/medusa-integration-module)
INTEGRATION_ENCRYPTION_KEY=replace-me

# Read by the auth module for multi-factor enrolment.
AUTH_MFA_ENCRYPTION_KEY=replace-me

# Vendor and platform telemetry stays off.
GORGO_DISABLE_TELEMETRY=true
MEDUSA_DISABLE_TELEMETRY=true

# Optional switches. Production cookies are always secure; only "true" is accepted.
# COOKIE_SECURE=true
# TLS for the database connection, and whether to verify its certificate.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Number of reverse proxies between the internet and the backend. 0 trusts no
# forwarded address (local development); 1 behind a single proxy such as
# Traefik. A wrong value makes every audit entry record the proxy's address, or
# lets a caller choose the address that is recorded. Must be a whole number.
TRUST_PROXY_HOPS=0

# Local test runs read an untracked test environment file in apps/backend (for
# example `.env.test`, which Jest loads) holding AUTH_MFA_ENCRYPTION_KEY (64
# random characters), TRUST_PROXY_HOPS=0 and BREAK_GLASS_ALERT_EMAILS. Create
# your own copy for local runs and never commit it.

# Comma-separated addresses told when the break-glass admin account is used, and
# reminded daily while its review stays open. Required in production: the backend
# refuses to start without at least one valid address. Use mailboxes of people
# who can act on it. Leave empty in development.
# BREAK_GLASS_ALERT_EMAILS=

# Where the admin dashboard lives, used for the link inside those emails.
ADMIN_APP_URL=http://localhost:9000/app

# SMTP configuration for transactional emails.
# Development mail is caught by Mailpit at http://localhost:8025. Production values live in the deployment environment, never here.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=store@example.test
SMTP_REPLY_TO=

# Storefront URL (used in email links)
STOREFRONT_URL=http://localhost:8000

# Shared secret sent as x-revalidate-secret to the storefront's /api/revalidate endpoint
# (must match REVALIDATE_SECRET in apps/storefront/.env.local)
REVALIDATE_SECRET=replace-me

# Fallback locale for emails when the order/customer carries none.
# Must be one of the locales in apps/backend/src/emails/i18n/messages (falls back to en).
STOREFRONT_DEFAULT_LOCALE=en

# Store branding used in email templates. These are the values the code falls
# back to when the variable is unset, repeated here so they are easy to change.
# STORE_NAME is also the sender name every email arrives under, so the inbox
# reads "Gorgo Medusa Store" instead of the bare SMTP_FROM address.
STORE_NAME="Gorgo Medusa Store"
STORE_EMAIL=hello@example.com

# Printed verbatim in the footer of every email, and left out of it when empty.
# Fill them in before going live rather than shipping a placeholder address to
# real customers. Many jurisdictions require a postal address in commercial mail.
# STORE_PHONE=+49 30 901820
# STORE_ADDRESS=Beispielstrasse 1, 10115 Berlin, Germany
STORE_PHONE=
STORE_ADDRESS=
