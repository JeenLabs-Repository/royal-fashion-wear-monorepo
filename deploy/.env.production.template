# Template for the production environment. This file holds key names and
# placeholders only. Real values go in Dokploy's environment tab, and the owner
# keeps a sealed offline copy of the key set. Never commit real values.
#
# Generate each secret with: openssl rand -hex 32
# Every secret needs at least 32 characters. The backend refuses to start in
# production when one is unset, still a placeholder or too short.

# Images pulled from the registry. Use the exact release tag, never latest.
BACKEND_IMAGE=ghcr.io/<owner>/<repo>/backend:v0.1.0
STOREFRONT_IMAGE=ghcr.io/<owner>/<repo>/storefront:v0.1.0

# Run database migrations when the backend container starts (true or false).
RUN_MIGRATIONS=true

# Telemetry stays off.
GORGO_DISABLE_TELEMETRY=true
MEDUSA_DISABLE_TELEMETRY=true

# Database on the separate private host. Use the private address of that host.
# Example shape: postgres://<user>:<password>@<private-db-host>:5432/<database>
DATABASE_URL=replace-me
# Optional TLS on the private link. Set DATABASE_SSL=true to turn it on and
# DATABASE_SSL_REJECT_UNAUTHORIZED=false only for a self-signed certificate.
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=

# Secrets.
JWT_SECRET=replace-me
COOKIE_SECRET=replace-me
# Must be identical on every backend process and backed up offline with the
# database backups. Losing it makes stored integration secrets unreadable.
INTEGRATION_ENCRYPTION_KEY=replace-me
AUTH_MFA_ENCRYPTION_KEY=replace-me
# Shared with the storefront, which receives the same value.
REVALIDATE_SECRET=replace-me

# Public origins. Example shapes: https://shop.example.com and https://api.example.com
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://shop.example.com,https://api.example.com
STOREFRONT_URL=https://shop.example.com

# Optional, server-only. Address the storefront server uses to reach the backend when it differs from the
# public address (for example http://backend:9000 on a shared network). Leave empty to use the public address.
MEDUSA_BACKEND_URL=

# Email language fallback and store branding used in email templates.
STOREFRONT_DEFAULT_LOCALE=en
STORE_NAME=
STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=

# SMTP for transactional email. Leave SMTP_HOST empty to send no email.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# S3-compatible file storage. Leave S3_BUCKET empty to keep uploads on the
# backend_static volume.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Number of reverse proxies in front of the backend. Dokploy's proxy is one hop.
# A wrong value makes every audit entry record the proxy address.
TRUST_PROXY_HOPS=1
