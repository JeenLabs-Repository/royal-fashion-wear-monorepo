{
  "name": "royal-fashion-wear-monorepo",
  "private": true,
  "description": "Medusa DTC Starter by Gorgo: a Medusa backend and a Next.js storefront for direct-to-consumer commerce. Production-ready.",
  "author": "Gorgo (https://gorgojs.com)",
  "license": "MIT",
  "homepage": "https://docs.gorgojs.com/tools/medusa-dtc-starter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorgojs/medusa-dtc-starter.git"
  },
  "bugs": "https://github.com/gorgojs/medusa-dtc-starter/issues",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/gorgo-medusa-backend",
    "backend:seed:test": "turbo seed:test-data --filter=@dtc/gorgo-medusa-backend",
    "backend:dev": "turbo dev --filter=@dtc/gorgo-medusa-backend",
    "storefront:dev": "turbo dev --filter=@dtc/gorgo-medusa-storefront",
    "guards": "node scripts/run-guards.mjs",
    "check:vendor-schema": "node scripts/check-vendor-schema.mjs",
    "release:prepare": "sh scripts/release-prepare.sh",
    "release:tag": "sh scripts/release-tag.sh",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "vendor-portal:dev": "turbo dev --filter=@dtc/vendor-portal"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "husky": "9.1.7",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
